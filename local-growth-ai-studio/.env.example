# V2 uses clearly labeled local templates until a provider is explicitly enabled.
# Live calls are billable. Do not enable or add credentials without owner approval.
ENABLE_LIVE_AI=0
# OpenAI is primary; Anthropic is an optional provider adapter.
AI_PROVIDER=openai

# OpenAI (optional)
OPENAI_PROVIDER_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional real web search. Tavily's no-card free tier currently includes
# 1,000 search credits/month. Search remains disabled unless explicitly enabled.
ENABLE_MARKET_SEARCH=0
TAVILY_API_KEY=

# Anthropic / Claude (optional)
ANTHROPIC_PROVIDER_ENABLED=0
ANTHROPIC_API_KEY=
# Low-cost image + structured-output model suitable for this Studio.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

ALLOW_MOCK_GENERATION=1
# Required for live use: a unique private access code of at least 24 characters.
STUDIO_ACCESS_CODE=
# HTTPS origin required for live use; e.g. https://studio.your-domain.example
APP_ORIGIN=
HOST=127.0.0.1
PORT=8787
# Credits are server-owned. These defaults are safe for the private beta.
INITIAL_CREDITS=100
GENERATION_CREDIT_COST=1
# Automatically refund reservations still pending after this many minutes.
PENDING_JOB_TIMEOUT_MINUTES=15
# Put on a persistent private volume; never inside public/.
CREDIT_DB=./data/credits.sqlite

# V2 persistent business workspace (projects, research, products, brand, saved outputs)
WORKSPACE_DB=./data/workspace.sqlite
