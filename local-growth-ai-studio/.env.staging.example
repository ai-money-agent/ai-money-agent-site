# Copy these values into the private HTTPS host's secret/environment settings.
# Replace every placeholder before starting; do not commit real access codes.
HOST=0.0.0.0
PORT=8787
APP_ORIGIN=https://studio-owner-only.example.invalid

# Account IDs map to distinct, randomly generated, 24+ character access codes.
# Keep codes in the host's secret manager. There is no public sign-up route.
STUDIO_ACCOUNTS_JSON={"owner":"REPLACE_WITH_RANDOM_32_CHAR_OR_LONGER_SECRET"}

# Keep all paths on a separate persistent staging volume mounted at /app/data.
WORKSPACE_DB=/app/data/workspace.sqlite
CREDIT_DB=/app/data/credits.sqlite
PRODUCT_FILES_DIR=/app/data/generated-products

# The deterministic local product factory works without provider keys or API spend.
ENABLE_LIVE_AI=0
AI_PROVIDER=openai
OPENAI_PROVIDER_ENABLED=0
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_PROVIDER_ENABLED=0
ALLOW_MOCK_GENERATION=1
